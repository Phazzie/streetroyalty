# Copy the keys you use into the host secret store.
# Do not commit a real .env. Preview runs in sandbox when these are empty.

# Printful — https://developers.printful.com/
PRINTFUL_API_KEY=
# Required for account-level tokens. Store-scoped tokens can leave this blank.
PRINTFUL_STORE_ID=
# Hex secret from the Printful webhook configuration (the app hex-decodes it).
PRINTFUL_WEBHOOK_SECRET=
# sandbox (default when PRINTFUL_API_KEY is empty) or live
POD_MODE=sandbox

# Stripe Checkout — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# sandbox (default when STRIPE_SECRET_KEY is empty) or live
PAYMENTS_MODE=sandbox

# Public https origin Printful uses to download print files. No trailing slash.
APP_PUBLIC_URL=

# Retail price = wholesale × this. Default 2.2, clamped to 1–5.
STUDIO_MARKUP=2.2

# Comma-separated sign-in emails allowed to reconnect the shared Printful webhook.
# Empty means nobody can. A customer must not be able to rotate this secret.
STUDIO_ADMIN_EMAILS=

# Signs print-file URLs. Required when POD_MODE=live. Sandbox has a built-in secret.
PRINT_FILE_SIGNING_SECRET=

# Injected on deploy. Leave unset in local preview (embedded Postgres).
# DATABASE_URL=
